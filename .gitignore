# SOP RAG corpus repository (Flying Peptides training case).
# Tracked: clean corpus, master document list, scripts, RAG pipeline code, evaluation.
# Everything else in RAG_sys stays local.
/*
!/.gitignore
!/README.md
!/build_master_list.py
!/check_attribution.py
!/requirements.txt
!/rag/
!/eval/
!/SOPs/
/SOPs/*
!/SOPs/clean/

# Python bytecode, wherever it appears
__pycache__/
